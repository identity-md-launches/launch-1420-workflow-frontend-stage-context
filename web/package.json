{
  "name": "pulse-swarm-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/export.mjs --check",
    "test": "tsx --test tests/core.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check:rpc": "node scripts/check-rpc.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
